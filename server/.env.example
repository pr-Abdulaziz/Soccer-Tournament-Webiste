# Copy this file to server/.env and fill in real values.
# server/.env is git-ignored - never commit it.

# Server
PORT=5000
# Frontend origin(s) allowed to call the API (comma-separated)
CLIENT_ORIGIN=http://localhost:3000
# Uncomment only when running behind a reverse proxy / load balancer
# TRUST_PROXY=1

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# JWT - required, at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Secret code needed to register the (single) admin account.
# Leave empty to disable admin sign-up entirely.
ADMIN_SIGNUP_CODE=

# Email (for match reminders)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
